# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="D&D dev kid"

# GITHUB_TOKEN: Personal Access Token for committing bestiary data.
