  "features": [
    {
      "index": "otherworldly_patron",
      "class": {
        "index": "warlock",
        "name": "warlock",
        "url": "/assets/atlas/class/json/warlock.json"
      },
      "name": "otherworldly patron",
      "level": 1,
      "prerequisites": [],
      "desc": [
        "At 1st level, you have struck a bargain with an otherworldly being, such as the Fiend. Your choice grants you features at 1st level and again at 6th, 10th, and 14th level."
      ],
      "url": "/assets/atlas/features/json/otherworldly_patron.json",
      "updated_at": "2026-07-13T06:30:11.950Z",
      "image": "/assets/atlas/features/images/otherworldly_patron.webp",
      "feature_specific": {
