  "traits": [
    {
      "name": "darkvision",
      "index": "darkvision",
      "desc": "You have superior vision in dark and dim conditions. You can see in dim light within 60 feet of you as if it were bright light, and in darkness as if it were dim light. You cannot discern color in darkness, only shades of gray.",
      "trait_specific": {
        "passive_modifiers": {
          "darkvision": 60
        }
      }
    },
    {
      "name": "fey ancestry",
      "index": "fey_ancestry",
      "desc": "You have advantage on saving throws against being charmed, and magic cannot put you to sleep.",
      "trait_specific": {
        "passive_modifiers": {
          "advantage": [
            {
              "name": "Saving Throws against being charmed",
              "condition": {
                "index": "charmed",
                "name": "charmed",
                "url": "/assets/atlas/conditions/json/charmed.json"
              }
            }
          ],
          "immunity": [
            {
              "name": "magic sleep"
            }
          ]
        }
      }
    },
    {
      "name": "trance",
      "index": "trance",
      "desc": "Elves do not need to sleep. Instead, they meditate deeply, remaining semiconscious, for 4 hours a day. (The Common word for such meditation is \"trance.\") While meditating, you can dream after a fashion; such dreams are actually mental exercises that have become reflexive through years of practice. After resting this way, you gain the same benefit that a human does from 8 hours of sleep."
    },
    {
      "name": "keen senses",
      "index": "keen_senses",
      "desc": "You have proficiency in the Perception skill."
    },
    {
      "name": "superior darkvision",
      "index": "superior_darkvision",
      "desc": "Your darkvision has a radius of 120 feet.",
      "trait_specific": {
        "passive_modifiers": {
          "darkvision": 120
        }
      }
    },
    {
      "name": "sunlight sensitivity",
      "index": "sunlight_sensitivity",
      "desc": "You have disadvantage on attack rolls and on Wisdom (Perception) checks that rely on sight when you, the target of your attack, or whatever you are trying to perceive is in direct sunlight.",
      "trait_specific": {
        "passive_modifiers": {
          "disadvantage": [
            "Attack rolls in direct sunlight",
            "Perception checks that rely on sight in direct sunlight"
          ]
        }
      }
    },
    {
      "name": "drow magic",
      "index": "drow_magic",
      "desc": "You know the dancing lights cantrip. When you reach 3rd level, you can cast the faerie fire spell once with this trait and regain the ability to do so when you finish a long rest. When you reach 5th level, you can cast the darkness spell once with this trait and regain the ability to do so when you finish a long rest. Charisma is your spellcasting ability for these spells.",
      "trait_specific": {
        "spellcasting_ability": {
          "index": "charisma",
          "name": "charisma",
