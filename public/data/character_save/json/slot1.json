  "traits": [
    {
      "name": "Giant Ancestry",
      "index": "giant_ancestry",
      "desc": "You possess supernatural traits inherited from giant ancestors. Choose one of the following benefits when selecting this trait:\n- Cloud's Jaunt: As a Bonus Action, you magically teleport up to 30 feet to an unoccupied space you can see.\n- Fire's Burn: When you hit a target with an attack roll and deal damage, you can deal an extra 1d10 Fire damage.\n- Frost's Chill: When you hit a target with an attack roll and deal damage, you can deal an extra 1d6 Cold damage and reduce the target's Speed by 10 feet until the start of your next turn.\n- Hill's Tumble: When you hit a Large or smaller creature with an attack roll, you can knock that creature Prone.\n- Stone's Endurance: When you take damage, you can use a Reaction to roll 1d12 + your Constitution modifier and reduce the damage by that total.\n- Storm's Thunder: When you take damage from a creature within 60 feet, you can use a Reaction to deal 1d8 Thunder damage to that creature.\nYou can use your chosen benefit a number of times equal to your Proficiency Bonus per Long Rest."
    },
    {
      "name": "Large Form",
      "index": "large_form",
      "desc": "Starting at level 5, as a Bonus Action, if you are in a space large enough, you can magically transform into a Large creature for 10 minutes or until you end it (no action required) or you are Incapacitated.\nWhile Large, you have Advantage on Strength checks, and your Speed increases by 10 feet.\nOnce you use this trait, you can't use it again until you finish a Long Rest."
    },
    {
      "name": "Powerful Build",
      "index": "powerful_build",
      "desc": "You have Advantage on Ability Checks made to end the Grappled condition.\nIn addition, you count as one size larger when determining your carrying capacity and the weight you can push, drag, or lift."
    }
  ],
