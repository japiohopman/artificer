{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/equipment_pack.schema.json",
  "title": "Equipment Pack",
  "description": "Schema for equipment packs which contain other items.",
  "allOf": [
    { "$ref": "equipment.schema.json" },
    {
      "type": "object",
      "required": ["contents"],
      "properties": {
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "object",
                "properties": {
                  "index": { "type": "string" },
                  "name": { "type": "string" },
                  "url": { "type": "string" }
                },
                "required": ["index", "name", "url"]
              },
              "quantity": { "type": "integer", "minimum": 1 }
            },
            "required": ["item", "quantity"]
          }
        }
      }
    }
  ]
}
