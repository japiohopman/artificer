{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/magic_item.schema.json",
  "title": "Magic Item",
  "description": "Schema for magical equipment items with machine-readable effects.",
  "allOf": [
    { "$ref": "equipment.schema.json" },
    {
      "type": "object",
      "required": ["rarity"],
      "properties": {
        "rarity": {
          "type": "string",
          "enum": ["Common", "Uncommon", "Rare", "Very Rare", "Legendary", "Artifact", "Varies"]
        },
        "requires_attunement": { "type": "boolean", "default": false },
        "attunement_details": { "type": "string" },
        "attunement_rules": {
          "type": "object",
          "properties": {
            "index": { "type": "string" },
            "name": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["damage", "condition", "save", "light", "bonus", "other"] },
              "description": { "type": "string" },
              "details": { "type": "object" }
            },
            "required": ["type", "description"]
          }
        }
      }
    }
  ]
}
