{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/region.schema.json",
  "title": "Region",
  "description": "A large geographic region within a continent.",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "world": { "type": "string" },
    "continent": { "type": "string" },
    "region": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "wiki": { "type": "string" },
    "image": { "type": "string" },
    "thumbnail": { "type": "string" },
    "banner": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "trade": { "$ref": "trade.schema.json" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
