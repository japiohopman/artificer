{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/material.schema.json",
  "title": "Material",
  "description": "Schema for crafting materials in the game atlas.",
  "type": "object",
  "required": ["index", "name", "category", "rarity"],
  "properties": {
    "index": { "type": "string" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "rarity": { "type": "string" },
    "properties": { "type": "array", "items": { "type": "string" } },
    "gameEffect": { "type": "string" },
    "weight": { "type": "number" },
    "value": { "type": "number" },
    "url": { "type": "string", "pattern": "^/assets/atlas/materials_categories/json/.+\\.json$" },
    "imageUrl": { "type": "string", "pattern": "^/assets/atlas/materials_categories/images/.+\\.webp$" }
  }
}
