{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/crafted_item.schema.json",
  "title": "Crafted Item",
  "description": "Schema for unique items produced through crafting.",
  "type": "object",
  "required": ["index", "name", "kind"],
  "properties": {
    "index": { "type": "string" },
    "name": { "type": "string" },
    "kind": { "type": "string" },
    "rarity": { "type": "string" },
    "desc": { "type": "array", "items": { "type": "string" } },
    "gameEffect": { "type": "string" },
    "properties": { "type": "array", "items": { "type": "string" } },
    "materialComposition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["materialId", "role"],
        "properties": {
          "materialId": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "url": { "type": "string", "pattern": "^/assets/atlas/equipment/json/.+\\.json$" },
    "imageUrl": { "type": "string", "pattern": "^/assets/atlas/equipment/images/.+\\.webp$" }
  }
}
