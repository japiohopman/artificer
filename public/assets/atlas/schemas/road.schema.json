{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/japiohopman/artificer/main/public/assets/atlas/schemas/road.schema.json",
  "title": "Road",
  "description": "A road, trail, or trade route.",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string", "description": "e.g., road, trail, trade_route, passage." },
    "parent": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "wiki": { "type": "string" },
    "image": { "type": "string" },
    "thumbnail": { "type": "string" },
    "banner": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "destinations": { "type": "array", "items": { "type": "string" } },
    "trade": { "$ref": "trade.schema.json" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
