  "feature": {
    "name": "Alert",
    "desc": [
      "Always on the lookout for danger, you gain a bonus to your initiative rolls equal to your Proficiency Bonus. Additionally, you can't be surprised while you are conscious, and other creatures don't gain advantage on attack rolls against you as a result of being hidden from you."
    ]
  },
  "suggested_characteristics": {
    "traits": [
      "I'm always polite and respectful.",
      "I'm always on the lookout for trouble.",
      "I believe in the law and the order it brings.",
      "I face problems head-on. A simple, direct solution is the best path to success.",
      "I'm used to following orders, but I'm also used to giving them.",
      "I have a crude sense of humor.",
      "I'm a bit of a stickler for the rules.",
      "I can stare down a hell hound without flinching."
    ],
    "ideals": [
      "Order. The law is meant to protect everyone. (Lawful)",
      "Duty. I do what I must and obey just authority. (Lawful)",
      "Protection. It's my job to keep the weak safe. (Good)",
      "Power. Might makes right. (Evil)",
      "Vigilance. Always be prepared. (Neutral)",
      "Honor. My word is my bond. (Any)"
    ],
    "bonds": [
      "I'll never forget the ones I failed to protect.",
      "My loyalty is to my city and its people.",
      "Someone saved my life during a riot; I owe them everything.",
      "I fight for those who cannot fight for themselves.",
      "My honor is my life.",
      "I'm trying to find the one who framed me and cost me my position."
    ],
    "flaws": [
      "I obey the law, even if the law causes misery.",
      "I have little respect for anyone who is not a proven warrior.",
      "I'm inflexible in my thinking.",
      "My hatred of criminals is blind and unreasoning.",
      "I'd rather eat my armor than admit when I'm wrong.",
      "I sometimes take the law into my own hands when I feel justice isn't being served."
    ]
  },
