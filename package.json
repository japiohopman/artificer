{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "validate:assets": "node tools/validateAssets.cjs",
    "generate:tiles": "python tools/generate_tiles.py",
    "generate:faerun-tiles": "python tools/generate_tiles.py --source \"public/assets/atlas/world/maps/Sword_Coast_Map _faerun.png\" --output public/tiles/faerun --metadata",
    "generate:equipment-index": "node tools/generateEquipmentIndex.cjs",
    "generate:spell-index": "node tools/generateSpellIndex.cjs",
    "generate:enemy-index": "node tools/generateEnemyIndex.cjs",
    "normalize:assets": "node tools/normalizeAllAssets.cjs",
    "check:assets": "npm run normalize:assets && npm run validate:assets",
    "test": "npm run lint && npm run check:assets && npx playwright test tests/"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@3d-dice/dice-parser-interface": "^0.2.1",
    "@3d-dice/dice-roller-parser": "^0.2.6",
    "@3d-dice/dice-themes": "^0.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/howler": "^2.2.13",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "babylonjs-gltf2interface": "^5.57.1",
    "clsx": "^2.1.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "howler": "^2.2.4",
    "js-yaml": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "octokit": "^5.0.5",
    "playwright": "^1.61.1",
    "qs": "^6.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "wavesurfer.js": "^7.12.10",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "jsonschema": "^1.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@3d-dice/dice-box@1.1.4": true,
    "@firebase/util@1.15.1": true,
    "@google/genai@1.52.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
